# Step 3 of a data set run whose data is valid: the floating pill says nothing needs attention, steps a section forward and back,
# opens its section list and jumps to Schedule III; Check then finds no problem.
click fp-nav-0
wait_until fp-pill-open name="All sections · Page 1 · 1 of 9 · Return details" --timeout-ms 10000
click fp-pill-next
wait_until fp-pill-open name="All sections · Part I · 2 of 9 · Background Information on Taxpayer/filer" --timeout-ms 5000
click fp-pill-prev
wait_until fp-pill-open name="All sections · Page 1 · 1 of 9 · Return details" --timeout-ms 5000
click fp-pill-list
wait_until fp-section-6 --timeout-ms 5000
click fp-section-6
wait_until fp-pill-open name="All sections · Part V · 7 of 9 · Schedule III – Tax Credits/Payments" --timeout-ms 5000
click fp-nav-0
wait_until fp-check --timeout-ms 5000
click fp-check
wait_until fp-pill-open name="All sections · Page 1 · 1 of 9 · Return details" --timeout-ms 10000 --screenshot
