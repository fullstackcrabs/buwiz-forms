# First-run sign-up on the phone layout (Android): as ui-sign-up.wants, with three differences.
# Every box is filled with set_value, not type: typing raises the keyboard, and with the keyboard
# up the next press (on a select trigger or an option) only puts the keyboard away (a finger does the same), so the sheet stays open over
# the next control (`occluded_by`). Each sheet is awaited closed before the next press. Home is tab-home, not nav-home.
# Starts on the New taxpayer form (press setup-solo first): $tin_field is the TIN's text box, which has a generated id
# (NSH's OtpInput puts the testID new-tp-tin on the group of cells, not on the box that takes the text), so read it
# from a snapshot of the form (the textbox named "TIN, 9 digits") and pass it in.
wait_until new-tp-name --timeout-ms 5000
click new-tp-start-trigger
wait_until $start_option --timeout-ms 5000
click $start_option
wait_until $start_option --absent --timeout-ms 5000
set_value $tin_field $tin
set_value new-tp-name $name
set_value new-tp-registered_address $address
click new-tp-zip_code-trigger
wait_until new-tp-zip_code-search --timeout-ms 5000
set_value new-tp-zip_code-search $zip
wait_until new-tp-zip_code-opt-$zip --timeout-ms 5000
click new-tp-zip_code-opt-$zip
wait_until new-tp-zip_code-search --absent --timeout-ms 5000
click new-tp-rdo_code-trigger
wait_until new-tp-rdo_code-search --timeout-ms 5000
set_value new-tp-rdo_code-search $rdo
wait_until new-tp-rdo_code-opt-$rdo --timeout-ms 5000
click new-tp-rdo_code-opt-$rdo
wait_until new-tp-rdo_code-search --absent --timeout-ms 5000
click new-tp-save --screenshot
wait_until tab-home --timeout-ms 10000
assert home-tp-$tin --screenshot
