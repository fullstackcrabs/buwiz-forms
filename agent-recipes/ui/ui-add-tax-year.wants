# Add tax year $year to the taxpayer's branch, copying the forms of the year shown. Starts and ends with the tax-profile
# panel closed. A year the branch already has is not offered: skip this for it.
click tb-panel
wait_until panel-open-forms --timeout-ms 5000
click panel-open-forms
wait_until tp-add-year-open --timeout-ms 5000
click tp-add-year-open
wait_until tp-add-year-select-trigger --timeout-ms 5000
click tp-add-year-select-trigger
wait_until tp-add-year-select-opt-$year --timeout-ms 5000
click tp-add-year-select-opt-$year
click tp-add-year-add
wait_until tp-years-$year --timeout-ms 5000
click tb-panel
wait_until panel-open-forms --absent --timeout-ms 5000
