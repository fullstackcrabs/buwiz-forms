# Step 3 of the data set run that leaves the email blank (missing-email): the pill counts one item needing attention, its Next
# lands on Item 12, the pill steps back to the top, its section list jumps to Part I, Next brings the box clear of the pill again, the email is typed ($email_fixed) and the
# count is gone.
click fp-nav-0
wait_until fp-pill-open name="All sections · 1 to do · Page 1 · Return details · 1 item needs attention" --timeout-ms 10000 --screenshot
click fp-pill-next
wait_until fp-pill-open name="All sections · 1 of 1 to do · Part I · Item 12 · Email Address · 1 item needs attention" --timeout-ms 5000
click fp-pill-list
wait_until fp-section-1 --timeout-ms 5000
click fp-section-1
wait_until fp-nav-count value="2 of 9" --timeout-ms 5000
click fp-pill-next
wait_until fp-pill-open name="All sections · 1 of 1 to do · Part I · Item 12 · Email Address · 1 item needs attention" --timeout-ms 5000
wait_until fp-txtEmail in_viewport=true --timeout-ms 5000
set_value fp-txtEmail $email_fixed
click fp-nav-0
wait_until fp-pill-open name="All sections · Page 1 · 1 of 9 · Return details" --timeout-ms 10000
click fp-pill-next
wait_until fp-pill-open name="All sections · Part I · 2 of 9 · Background Information on Taxpayer/filer" --timeout-ms 5000
click fp-pill-prev
wait_until fp-pill-open name="All sections · Page 1 · 1 of 9 · Return details" --timeout-ms 5000
click fp-check
wait_until fp-pill-open name="All sections · Page 1 · 1 of 9 · Return details" --timeout-ms 10000 --screenshot
